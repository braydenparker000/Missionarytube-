{
  "name": "missionarytube",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis frontend deployment using the existing MissionaryTube Azure federation",
  "type": "module",
  "workspaces": ["backend"],
  "scripts": {
    "test": "node scripts/check.mjs && node --test tests/*.test.mjs scripts/*.test.mjs",
    "build": "node scripts/build-jarvis.mjs && node scripts/build-backend.mjs",
    "test:podcasts": "node --test tests/podcasts-mobile-browser.test.mjs backend/tests/podcasts.test.js backend/tests/podcast-directory-contract.test.js",
    "test:daily-board": "node --test tests/daily-board-report.test.mjs tests/daily-board-browser.test.mjs scripts/frontend-source.test.mjs scripts/publish-daily-board.test.mjs tests/privacy.test.mjs",
    "test:jarvis": "npm --prefix .jarvis-source test",
    "test:backend": "npm --prefix backend test",
    "test:tools": "python -m unittest discover -s tests/python -p 'test_*.py' -v"
  },
  "dependencies": {
    "@libmedia/avplayer": "1.3.1",
    "@mediabunny/ac3": "1.55.7",
    "@mediabunny/dts": "1.55.7",
    "gsap": "3.15.0",
    "mediabunny": "1.55.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
