{
  "name": "missionarytube",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis frontend deployment using the existing MissionaryTube Azure federation",
  "type": "module",
  "scripts": {
    "test": "node scripts/check.mjs && node --test",
    "build": "node scripts/build-jarvis.mjs",
    "pin:check": "node scripts/pin-player-libs.mjs --check",
    "test:browser": "node tests/browser/youtube-flow.mjs",
    "build:legacy": "node scripts/build.mjs",
    "test:jarvis": "npm --prefix .jarvis-source test"
  },
  "dependencies": {
    "@libmedia/avplayer": "1.3.1",
    "@mediabunny/ac3": "1.55.7",
    "@mediabunny/dts": "1.55.7",
    "gsap": "3.15.0",
    "mediabunny": "1.55.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
