# Copy to .env and fill in. .env is git-ignored: it holds a database password.
#
#   cp .env.example .env
#   sed -i "s/CHANGE_ME/$(openssl rand -base64 24 | tr -d '=+/')/" .env

# The public https address of this instance, with no scheme and no trailing
# slash. It must be the address the browser reaches, because Invidious builds
# its manifest and caption URLs from it.
INVIDIOUS_DOMAIN=invidious.example.org

# Database credentials. Only these two containers ever use them.
POSTGRES_DB=invidious
POSTGRES_USER=invidious
POSTGRES_PASSWORD=CHANGE_ME
